+def fuente_iconos():
+    for fam in ("Segoe Fluent Icons", "Segoe MDL2 Assets"):
+        if fuente_instalada(fam):
+            return fam
+    return None
+
+
+def barra_consumo_hoy():
+    """(principal, detalle) del gasto de hoy, de day_by_model (lo terminado hoy)."""
+    data = day_by_model()
+    real = sum(b["cost"] for k, b in data.items() if k[0] == "real")
+    equiv = sum(b["cost"] for k, b in data.items() if k[0] == "equiv")
+    n = sum(b["n"] for k, b in data.items() if not k[2])
+    return f"${real + equiv:.2f}", f"real ${real:.2f} · equivalente Max ${equiv:.2f} · {n} tareas"
+
+
+def barra_estado_fallos():
+    """Cuántas filas del mapa están en «falla» ahora (0 = nada falla)."""
+    return sum(1 for r in (_AV.get("rows") or {}).values() if isinstance(r, dict) and r.get("estado") == "falla")
+
+
+def _switch_ctk(parent, initial, on_change, bg):
+    import customtkinter as ctk
+    cls = _SB.get("sw_cls")
+    if cls is None:
+        class _SwitchBarra(ctk.CTkSwitch):
+            # lo que esperan set_switch() y la paleta, como el interruptor clásico
+            @property
+            def _on(self):
+                return bool(self.get())
+
+            @_on.setter
+            def _on(self, v):
+                (self.select if v else self.deselect)()
+
+            def _animate_to(self, t):
+                (self.select if t >= 0.5 else self.deselect)()
+        cls = _SB["sw_cls"] = _SwitchBarra
+    sw = cls(parent, text="", width=46, switch_width=46, switch_height=26, corner_radius=13, button_length=0,
+             border_width=1, border_color="#8e8e93", fg_color=_tema_fijo("off_track"),
+             progress_color=THEME["green"], button_color="#ffffff", button_hover_color="#f2f2f7", bg_color=bg,
+             command=lambda: on_change(bool(sw.get())))
+    if initial:
+        sw.select()
+    try:  # teclado y foco visible, como el clásico
+        sw._canvas.configure(takefocus=1)
+        sw._canvas.bind("<space>", lambda _e: sw.toggle())
+        sw._canvas.bind("<Return>", lambda _e: sw.toggle())
+        sw._canvas.bind("<FocusIn>", lambda _e: sw.configure(border_color=THEME["blue"], border_width=2), add=True)
+        sw._canvas.bind("<FocusOut>", lambda _e: sw.configure(border_color="#8e8e93", border_width=1), add=True)
+    except Exception:
+        pass
+    return sw
+
+
+def _barra_pintar():
+    """Contadores, Consumo hoy y la tarjeta del guardrail de la barra lateral."""
+    w = _widgets
+    if w.get("nav_count_estado") is not None:
+        w["nav_count_estado"].config(text=str(barra_estado_fallos()))
+    if w.get("sb_consumo") is not None:
+        fp = (_tasks_fp[0], datetime.now().date().isoformat())
+        if fp != _SB["fp"]:
+            _SB["fp"] = fp
+            try:
+                v, det = barra_consumo_hoy()
+            except Exception as e:
+                v, det = "sin dato", f"no se pudo leer ({type(e).__name__})"
+            w["sb_consumo"].config(text=v)
+            w["sb_consumo_det"].config(text=det)
+    if w.get("sb_gr_nivel") is not None:
+        nivel = guardrail_level()
+        d = _ESP.get("dato") or {}
+        w["sb_gr_nivel"].config(text=next((lab for k, lab, _x in GUARDRAIL_LEVELS if k == nivel), nivel))
+        w["sb_gr_punto"].config(fg=THEME["green"] if nivel == "nunca" else THEME["blue"])
+        n = d.get("n")
+        w["sb_gr_cola"].config(text=("No se pudo leer cuántas esperan" if d.get("error") else
+                                     "Leyendo…" if n is None else f"{n} en espera de tu aprobación"))
+
