    "nunca": "R3"
  },
  "politicas": {
    "_que_es": "Politicas por tipo (solo R1): \"permitir\" = ese tipo no pregunta nunca. Son politicas, no aprobaciones concretas; en R2/R3 se ignoran.",
    "ejemplo_desactivado__escribir_fuera": "permitir"
  },
